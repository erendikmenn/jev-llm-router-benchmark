{"id": "demo-039", "split": "test", "language": "tr", "group": "coding", "prompt": "Listeyi verilen pozitif boyutta ardışık alt listelere bölen chunks(items, size) Python fonksiyonunu yaz; sıfırda ValueError üret.", "metric": "python_tests", "expected": null, "constraints": {"modality": "text", "requires_tools": false, "max_output_tokens": 256, "source": "synthetic_demo"}, "fixture": {"cheap": {"text": "def raises(fn):\n    try:\n        fn()\n    except ValueError:\n        return True\n    return False\n\ndef chunks(items, size):\n    return [items[i:i+size] for i in range(0, len(items), size)]", "usage": {"input_tokens": 122, "cached_input_tokens": 0, "output_tokens": 22}, "latency_ms": 148, "ttft_ms": null, "status": "ok"}, "strong": {"text": "def raises(fn):\n    try:\n        fn()\n    except ValueError:\n        return True\n    return False\n\ndef chunks(items, size):\n    if size <= 0: raise ValueError('size')\n    return [items[i:i+size] for i in range(0, len(items), size)]", "usage": {"input_tokens": 122, "cached_input_tokens": 0, "output_tokens": 33}, "latency_ms": 293, "ttft_ms": null, "status": "ok"}}, "jev_fixture": {"choice": "strong", "probabilities": {"cheap": 0.19, "strong": 0.81}, "confidence": 0.677, "task_type": "coding", "usage": {"input_tokens": 253, "cached_input_tokens": 0, "output_tokens": 24}, "latency_ms": 28}, "tests": [{"expression": "chunks([1,2,3], 2) == [[1,2],[3]]"}, {"expression": "raises(lambda: chunks([1], 0))"}]}
